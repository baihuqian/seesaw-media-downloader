# Copy to .env and fill in. .env is gitignored.
SEESAW_EMAIL=you@example.com
SEESAW_PASSWORD=your-password

# Which child to download. Only required if the account has more than one; a run
# covers exactly one child. Full name, a unique part of it, or a person id.
# SEESAW_CHILD=Alex Rivera

# Required by `download` (`list` writes nothing, and only uses it to report
# what you already have)
SEESAW_OUTPUT_DIR=./out

# Modes (all optional)
# SEESAW_DOWNLOAD_ALL=false
# SEESAW_SINCE=2026-01-01        # or a relative window like 30d

# Behaviour (all optional)
# SEESAW_CONCURRENCY=4
# SEESAW_SESSION_FILE=~/.config/seesaw-dl/session.json
# SEESAW_JSON=false
# SEESAW_LOG_LEVEL=info
